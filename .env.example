# --- Branding ---
BRAND_NAME=AgentSentinel
BRAND_OWNER=Abhijit
BRAND_TAGLINE=Security audits for AI coding agents
CONTACT_EMAIL=hello@your-domain.com
BASE_URL=https://agentsentinel.your-domain.com

# --- Security ---
SECRET_KEY=generate-with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECURE_COOKIES=true
ADMIN_EMAILS=you@your-domain.com
ALLOW_SIGNUP=true

# --- Database (docker-compose sets this for Postgres) ---
# DATABASE_URL=sqlite:///./data/agentsentinel.db
POSTGRES_PASSWORD=change-me

# --- Scanning ---
GIT_SCAN_ENABLED=true
GIT_ALLOWED_HOSTS=github.com,gitlab.com,bitbucket.org
MAX_UPLOAD_MB=25

# --- Billing (optional; without these, upgrades are requests you approve in /admin) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
